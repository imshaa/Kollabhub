# Copy this file to .env and replace the values with your own secrets.
SECRET_KEY=replace-this-with-a-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email settings for real OTP delivery
USE_REAL_EMAIL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password-or-app-password

# Redis / Celery settings for async background delivery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# For production 
REDIS_URL = xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-public-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=your-private-bucket-name
